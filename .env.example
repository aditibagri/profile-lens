# Required: cookies from a logged-in LinkedIn browser session.
# Option 2: load extension/ in Chrome/Firefox, then paste the copied .env block.
# Option 3: DevTools → Application → Cookies → https://www.linkedin.com
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Optional but recommended with Option 3: User-Agent of the same browser that minted the cookies.
LINKEDIN_USER_AGENT=

# Optional: extra cookies if hosted requests get 401/403 while local ones work.
LINKEDIN_LIAP=
LINKEDIN_BCOOKIE=
LINKEDIN_LIDC=
LINKEDIN_LI_A=

# Optional: if set, every request to /v1/profile must send X-API-Key.
API_KEY=

# Optional tuning
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=10
DECORATION_ID=com.linkedin.voyager.dash.deco.identity.profile.FullProfileWithEntities-93
